<view class="card">
  <text class="title">Green Leaf Tea House</text>
  <text class="muted">Visitor ID: {{visitorId}}</text>
  <input placeholder="Search products" confirm-type="search" bindconfirm="onSearch" />
  <button bindtap="onEvent">Track event</button>
  <button bindtap="onProduct">Open product</button>
  <button bindtap="onConsent">Privacy settings</button>
  <button bindtap="onDebug">Debug (all other APIs)</button>
  <button bindtap="onFlush">Flush queue</button>
</view>
<block wx:if="{{showBanner}}">
  <view class="mask" />
  <view class="banner">
    <text class="title">We care about your privacy</text>
    <text class="body">To improve this mini program, we use Matomo to measure your visits (pages viewed, searches and orders). The data is only used for analytics and is never sold. Nothing is sent until you agree.</text>
    <text class="link" bindtap="onConsent">Privacy settings</text>
    <view class="actions">
      <button bindtap="onRefuse">Decline</button>
      <button type="primary" bindtap="onAccept">Accept</button>
    </view>
  </view>
</block>
