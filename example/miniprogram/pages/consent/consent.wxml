<view class="card">
  <text class="title">Current status</text>
  <view><text>Opted out: {{optedOut ? 'Yes' : 'No'}}</text></view>
  <view><text>Storage (cookies) enabled: {{cookiesEnabled ? 'Yes' : 'No'}}</text></view>
  <view><text>Remembered tracking consent: {{rememberedConsent}}</text></view>
</view>
<view class="card">
  <text class="title">Tracking consent</text>
  <text class="muted">Nothing is sent without it</text>
  <button bindtap="onGive">Give consent (this session)</button>
  <button bindtap="onRemember">Remember consent (1 year)</button>
  <button bindtap="onForget">Withdraw consent</button>
</view>
<view class="card">
  <text class="title">Cookie consent</text>
  <text class="muted">Hits are sent, but nothing is stored on the device without it</text>
  <button bindtap="onGiveCookies">Give cookie consent (this session)</button>
  <button bindtap="onRememberCookies">Remember cookie consent (1 year)</button>
  <button bindtap="onForgetCookies">Withdraw cookie consent</button>
</view>
<view class="card">
  <button bindtap="onOptOut">Opt out</button>
  <button bindtap="onOptIn">Opt in</button>
  <button bindtap="onResetBanner">Show the consent banner again</button>
</view>
